# Vault
# Local dev (docker-compose): devsync-vault runs in `-dev` mode, so
# VAULT_TOKEN is whatever root token you pick and init-vault.sh seeds
# everything fresh on every `docker-compose up`.
# Production (Fly): devsync-vault is a real (non-dev) Vault, KMS-auto-unsealed
# on every restart - see fly/vault/ and DEPLOYMENT.md "Bootstrap Vault
# (one-time)". VAULT_TOKEN there should be the scoped, read-only
# `devsync-app` policy token that bootstrap creates, NOT the initial root
# token - see fly/vault/devsync-app-policy.hcl.
VAULT_ADDR=http://devsync-vault:8200
VAULT_TOKEN=your-root-token
# Signs JWTs - seeded into Vault's secret/auth path by init-vault.sh
JWT_SECRET_KEY=change-me-to-a-real-secret

# Production only (Fly-hosted Vault's AWS KMS auto-unseal - see
# fly/vault/vault-config.hcl and DEPLOYMENT.md "Bootstrap Vault
# (one-time)"). Not used by local dev at all - devsync-vault's `-dev` mode
# doesn't seal in the first place. Set these with `fly secrets set` on the
# devsync-vault app, never committed to a real .env:
#   VAULT_AWSKMS_SEAL_KEY_ID - the KMS key's alias or ARN
#   AWS_REGION               - region the KMS key lives in (fly.toml
#                               already sets this to us-east-1, matching
#                               the "iad" Fly region)
#   AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY - credentials for an IAM
#                               user scoped to kms:Encrypt/Decrypt/
#                               DescribeKey on that one key, nothing else

# Postgres / Mongo (seeded into Vault by init-vault.sh)
PG_USER=your_postgres_user
PG_PASSWORD=your_postgres_password
PG_DATABASE=devsync
# Local dev: the docker-compose devsync-mongodb container (below is what
# init-vault.sh seeds into Vault by default). Production: a MongoDB Atlas
# free M0 cluster - Atlas is a real, durable, managed Mongo (not
# self-hosted, and not something this repo provisions for you - it's a
# few clicks in Atlas's own console). See DEPLOYMENT.md "MongoDB Atlas"
# for the exact steps to create the M0 cluster and get this connection
# string; database.ts (mongoose.connect(mongoUri)) doesn't care which one
# it's pointed at, and MONGO_DATABASE/MONGO_USER/MONGO_PASSWORD below are
# only used to build the local docker-compose container's own credentials,
# not read by application code - Atlas already bakes user/pass into its
# connection string.
MONGO_URI=mongodb://localhost:27017/devsync
MONGO_DATABASE=devsync
MONGO_USER=your_mongo_user
MONGO_PASSWORD=your_mongo_password

# Service discovery
CONSUL_ADDR=http://devsync-consul:8500

# Bearer token required on GET /metrics - Prometheus scrapes leak infra
# topology (route names, status-code distributions, host/process stats),
# so this stays gated rather than open on the internet. Must match the
# `authorization.credentials` value in monitoring/prometheus.yml, or
# Prometheus's own scrape will start failing with 401s - change both
# together if you rotate it. Like GRAFANA_ADMIN_PASSWORD below, the
# checked-in default is fine for local dev only.
METRICS_TOKEN=devsync-local-metrics-token

# GitHub OAuth2 (create an OAuth App at https://github.com/settings/developers)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5001/auth/github/callback

# Frontend -> backend
# Local dev: the Express backend on your machine. Production: the
# Fly-hosted backend's public URL (e.g. https://devsync-backend.fly.dev),
# set as a Vercel project env var - see DEPLOYMENT.md "Point Vercel at the
# Fly backend". Note: as of this deployment pass, no frontend code actually
# reads this at runtime yet (pages/dashboard.tsx renders lib/mockData.ts,
# not a live fetch) - see DEPLOYMENT.md for that gap. Setting it now is
# still correct so it's ready the moment a live fetch is added.
NEXT_PUBLIC_BACKEND_URL=http://localhost:5001

# Grafana (optional, defaults to admin/admin)
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
