        "autoprefixer": "^10.5.4",
        "concurrently": "^9.1.2",
        "eslint": "^8.57.1",
        "eslint-config-next": "15.5.24",
        "jest": "^30.5.0",
        "postcss": "^8.5.26",
        "supertest": "^7.2.2",
        "tailwindcss": "^3.4.19",
        "ts-jest": "^29.4.12",
        "ts-node-dev": "^2.0.0",
        "typescript": "^5.7.3"
    },
